<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <!-- Sadece bu klasör için geçerli kaynak -->
        <add key="godeva" value="https://git.godeva.com.tr/api/v4/projects/20/packages/nuget/index.json" />
    </packageSources>
    <packageSourceCredentials>
        <godeva>
            <add key="Username" value="%GITLAB_USER%" />
            <add key="ClearTextPassword" value="%GITLAB_TOKEN%" />
        </godeva>
    </packageSourceCredentials>
</configuration>
