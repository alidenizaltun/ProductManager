<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <!-- Sadece bu klasör için geçerli kaynaklar -->
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <add key="godeva" value="https://git.godeva.com.tr/api/v4/projects/20/packages/nuget/index.json" />
    </packageSources>
    <packageSourceCredentials>
        <godeva>
            <add key="Username" value="%GITLAB_USER%" />
            <add key="ClearTextPassword" value="%GITLAB_TOKEN%" />
        </godeva>
    </packageSourceCredentials>
    <!-- Bu solution'da godeva'dan gelen TEK paket Deva.Extensions.Gateway; geri kalan
         paketler aslında nuget.org'dan geliyor ama eşleme olmadan NuGet hepsini
         godeva'ya da soruyordu. Eşleme, godeva'ya SADECE bu tek paket için istek
         gitmesini sağlar (bkz. B2B'nin nuget.config'i - aynı sorunun teşhisi orada). -->
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="godeva">
            <package pattern="Deva.Extensions.Gateway" />
        </packageSource>
    </packageSourceMapping>
</configuration>
