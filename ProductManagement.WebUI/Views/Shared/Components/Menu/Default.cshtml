@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    bool IsController(string controller) =>
        currentController.Equals(controller, StringComparison.OrdinalIgnoreCase);

    bool IsAction(string controller, string action) =>
        currentController.Equals(controller, StringComparison.OrdinalIgnoreCase) &&
        currentAction.Equals(action, StringComparison.OrdinalIgnoreCase);

    bool IsInGroup(params string[] controllers)
    {
        foreach (var controller in controllers)
        {
            if (currentController.Equals(controller, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }

    string MenuItemClass(bool isActive) => isActive ? "nk-menu-item active current-page" : "nk-menu-item";
    string GroupClass(bool isOpen) => isOpen ? "nk-menu-item has-sub active current-page" : "nk-menu-item has-sub";
    string GroupStyle(bool isOpen) => isOpen ? "display:block;" : string.Empty;

    var isCatalogGroupOpen = IsInGroup("Products", "Categories", "Attributes");
    var isSupplyGroupOpen = IsInGroup("Suppliers", "Warehouses");
    var isOpsGroupOpen = IsInGroup("PriceLists", "Inventory");
}

<div class="nk-header nk-header-fixed is-light">
    <div class="container-fluid">
        <div class="nk-header-wrap">
            <div class="nk-menu-trigger d-xl-none ms-n1">
                <a href="#" class="nk-nav-toggle nk-quick-nav-icon" data-target="sidebarMenu">
                    <em class="icon ni ni-menu"></em>
                </a>
            </div>

            <div class="nk-header-app-name">
                <div class="nk-header-app-logo">
                    <em class="icon ni ni-package-fill bg-success-dim"></em>
                </div>
                <div class="nk-header-app-info">
                    <span class="sub-text">ProductManagement</span>
                    <span class="lead-text">Urun Yonetim Sistemi</span>
                </div>
            </div>

            <div class="nk-header-menu is-light">
                <div class="nk-header-menu-inner">
                    <ul class="nk-menu nk-menu-main">
                        <li class="nk-menu-item">
                            <a asp-controller="Home" asp-action="Index" class="nk-menu-link">
                                <span class="nk-menu-text">Genel Bakis</span>
                            </a>
                        </li>
                        <li class="nk-menu-item">
                            <a asp-controller="Products" asp-action="Index" class="nk-menu-link">
                                <span class="nk-menu-text">Urunler</span>
                            </a>
                        </li>
                        <li class="nk-menu-item">
                            <a asp-controller="Inventory" asp-action="Transactions" class="nk-menu-link">
                                <span class="nk-menu-text">Stok Hareketleri</span>
                            </a>
                        </li>
                        <li class="nk-menu-item">
                            <a asp-controller="PriceLists" asp-action="Index" class="nk-menu-link">
                                <span class="nk-menu-text">Fiyat Listeleri</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="nk-header-tools">
                <ul class="nk-quick-nav">
                    <li class="dropdown user-dropdown">
                        <a href="#" class="dropdown-toggle me-n1" data-bs-toggle="dropdown">
                            <div class="user-toggle">
                                <div class="user-avatar sm">
                                    <em class="icon ni ni-user-alt"></em>
                                </div>
                            </div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-md dropdown-menu-end">
                            <div class="dropdown-inner user-card-wrap bg-lighter d-none d-md-block">
                                <div class="user-card">
                                    <div class="user-avatar">
                                        <span>PM</span>
                                    </div>
                                    <div class="user-info">
                                        <span class="lead-text">ProductManagement</span>
                                        <span class="sub-text">Operasyon paneli</span>
                                    </div>
                                </div>
                            </div>
                            <div class="dropdown-inner">
                                <ul class="link-list">
                                    <li>
                                        <a asp-controller="Home" asp-action="Index">
                                            <em class="icon ni ni-dashboard"></em>
                                            <span>Genel Bakis</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a asp-controller="Home" asp-action="Privacy">
                                            <em class="icon ni ni-setting-alt"></em>
                                            <span>Gizlilik</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="nk-sidebar" data-content="sidebarMenu">
    <div class="nk-sidebar-inner" data-simplebar>
        <ul class="nk-menu nk-menu-md">
            <li class="nk-menu-heading">
                <h6 class="overline-title text-primary-alt">Genel</h6>
            </li>
            <li class="@MenuItemClass(IsAction("Home", "Index"))">
                <a asp-controller="Home" asp-action="Index" class="nk-menu-link">
                    <span class="nk-menu-icon"><em class="icon ni ni-dashboard"></em></span>
                    <span class="nk-menu-text">Genel Bakis</span>
                </a>
            </li>

            <li class="nk-menu-heading">
                <h6 class="overline-title text-primary-alt">Katalog</h6>
            </li>
            <li class="@GroupClass(isCatalogGroupOpen)">
                <a href="#" class="nk-menu-link nk-menu-toggle">
                    <span class="nk-menu-icon"><em class="icon ni ni-card-view"></em></span>
                    <span class="nk-menu-text">Urun Yonetimi</span>
                </a>
                <ul class="nk-menu-sub" style="@GroupStyle(isCatalogGroupOpen)">
                    <li class="@MenuItemClass(IsController("Products"))">
                        <a asp-controller="Products" asp-action="Index" class="nk-menu-link"><span class="nk-menu-text">Urunler</span></a>
                    </li>
                    <li class="@MenuItemClass(IsController("Categories"))">
                        <a asp-controller="Categories" asp-action="Index" class="nk-menu-link"><span class="nk-menu-text">Kategoriler</span></a>
                    </li>
                    <li class="@MenuItemClass(IsController("Attributes"))">
                        <a asp-controller="Attributes" asp-action="Index" class="nk-menu-link"><span class="nk-menu-text">Ozellikler</span></a>
                    </li>
                </ul>
            </li>

            <li class="nk-menu-heading">
                <h6 class="overline-title text-primary-alt">Tedarik Zinciri</h6>
            </li>
            <li class="@GroupClass(isSupplyGroupOpen)">
                <a href="#" class="nk-menu-link nk-menu-toggle">
                    <span class="nk-menu-icon"><em class="icon ni ni-truck"></em></span>
                    <span class="nk-menu-text">Tedarik ve Depo</span>
                </a>
                <ul class="nk-menu-sub" style="@GroupStyle(isSupplyGroupOpen)">
                    <li class="@MenuItemClass(IsController("Suppliers"))">
                        <a asp-controller="Suppliers" asp-action="Index" class="nk-menu-link"><span class="nk-menu-text">Tedarikciler</span></a>
                    </li>
                    <li class="@MenuItemClass(IsController("Warehouses"))">
                        <a asp-controller="Warehouses" asp-action="Index" class="nk-menu-link"><span class="nk-menu-text">Depolar</span></a>
                    </li>
                </ul>
            </li>

            <li class="nk-menu-heading">
                <h6 class="overline-title text-primary-alt">Operasyon</h6>
            </li>
            <li class="@GroupClass(isOpsGroupOpen)">
                <a href="#" class="nk-menu-link nk-menu-toggle">
                    <span class="nk-menu-icon"><em class="icon ni ni-setting-alt-fill"></em></span>
                    <span class="nk-menu-text">Stok ve Fiyat</span>
                </a>
                <ul class="nk-menu-sub" style="@GroupStyle(isOpsGroupOpen)">
                    <li class="@MenuItemClass(IsController("PriceLists"))">
                        <a asp-controller="PriceLists" asp-action="Index" class="nk-menu-link"><span class="nk-menu-text">Fiyat Listeleri</span></a>
                    </li>
                    <li class="@MenuItemClass(IsAction("Inventory", "Transactions"))">
                        <a asp-controller="Inventory" asp-action="Transactions" class="nk-menu-link"><span class="nk-menu-text">Stok Hareketleri</span></a>
                    </li>
                    <li class="@MenuItemClass(IsAction("Inventory", "Reservations"))">
                        <a asp-controller="Inventory" asp-action="Reservations" class="nk-menu-link"><span class="nk-menu-text">Rezervasyonlar</span></a>
                    </li>
                </ul>
            </li>

            <li class="nk-menu-heading">
                <h6 class="overline-title text-primary-alt">Sistem</h6>
            </li>
            <li class="@MenuItemClass(IsAction("Home", "Privacy"))">
                <a asp-controller="Home" asp-action="Privacy" class="nk-menu-link">
                    <span class="nk-menu-icon"><em class="icon ni ni-shield"></em></span>
                    <span class="nk-menu-text">Gizlilik</span>
                </a>
            </li>
        </ul>
    </div>
</div>
