@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="nk-content nk-content-fluid">
    <div class="container-fluid">
        <div class="nk-content-inner">
            <div class="nk-content-body">
                <div class="nk-block">
                    <div class="card card-bordered">
                        <div class="card-inner text-center py-5">
                            <div class="nk-error-ld text-danger mb-3">
                                <em class="icon ni ni-alert-circle-fill" style="font-size:2.5rem;"></em>
                            </div>
                            <h3 class="nk-error-title">İşlem sırasında beklenmeyen bir hata oluştu.</h3>
                            <p class="nk-error-text">Lütfen işlemi tekrar deneyin. Sorun devam ederse sistem yöneticisi ile iletişime geçin.</p>

                            @if (Model.ShowRequestId)
                            {
                                <p class="small text-soft mb-3">Talep No: @Model.RequestId</p>
                            }

                            <div class="d-flex justify-content-center gap-2">
                                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Panele Dön</a>
                                <a asp-controller="Home" asp-action="Privacy" class="btn btn-outline-light bg-white">Bilgi</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
