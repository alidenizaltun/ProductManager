@model ProductManagement.WebUI.Models.ProductOperations.ProductFormViewModel

<input asp-for="Id" type="hidden" />

<div class="card card-bordered pm-form-card">
    <div class="card-inner">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <partial name="_FormFields" model="Model" />

        <div class="mt-4 pt-3 border-top d-flex flex-wrap justify-content-end gap-2">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Index" class="btn btn-outline-light">Listeye Dön</a>
            @if (Model.Id.HasValue)
            {
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Detay</a>
            }
        </div>
    </div>
</div>
