@model ProductManager.WebUI.Models.ProductOperations.CategoryFormViewModel

@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Kategori Düzenle" : "Yeni Kategori";
}

<div class="nk-content">
    <div class="container-fluid">
        <div class="nk-content-inner">
            <div class="nk-content-body">
                <div class="nk-block-head nk-block-head-sm">
                    <div class="nk-block-between">
                        <div class="nk-block-head-content">
                            <h3 class="nk-block-title page-title">@(isEdit ? "Kategori Düzenle" : "Yeni Kategori")</h3>
                            <div class="nk-block-des text-soft">
                                <p>Kategori kodu, adı ve hiyerarşi bilgisini düzenleyin.</p>
                            </div>
                        </div>
                        <div class="nk-block-head-content">
                            <a asp-action="Index" class="btn btn-outline-light">Listeye Dön</a>
                        </div>
                    </div>
                </div>

                @await Html.PartialAsync("_StatusMessage")

                <div class="nk-block">
                    <div class="card card-bordered">
                        <div class="card-inner">
                            <div class="card-head">
                                <h5 class="card-title">Kategori Bilgileri</h5>
                            </div>

                            <form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" class="row g-4">
                                @Html.AntiForgeryToken()
                                <input asp-for="Id" type="hidden" />

                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                <div class="col-lg-4">
                                    <div class="form-group">
                                        <label asp-for="Code" class="form-label"></label>
                                        <div class="form-control-wrap">
                                            <input asp-for="Code" class="form-control" placeholder="Örn: KAT-001" />
                                        </div>
                                        <span asp-validation-for="Code" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-lg-8">
                                    <div class="form-group">
                                        <label asp-for="Name" class="form-label"></label>
                                        <div class="form-control-wrap">
                                            <input asp-for="Name" class="form-control" placeholder="Kategori adını girin" />
                                        </div>
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label asp-for="Description" class="form-label"></label>
                                        <div class="form-control-wrap">
                                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Kategori açıklaması"></textarea>
                                        </div>
                                        <span asp-validation-for="Description" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label asp-for="ParentCategoryId" class="form-label"></label>
                                        <div class="form-control-wrap">
                                            <select asp-for="ParentCategoryId" asp-items="Model.ParentCategoryOptions" class="form-select"></select>
                                        </div>
                                        <span asp-validation-for="ParentCategoryId" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="form-group">
                                        <button type="submit" class="btn btn-primary">
                                            <em class="icon ni ni-save"></em>
                                            <span>@(isEdit ? "Değişiklikleri Kaydet" : "Kategoriyi Kaydet")</span>
                                        </button>
                                        <a asp-action="Index" class="btn btn-outline-light">İptal</a>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
