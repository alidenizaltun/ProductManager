@model ProductManager.WebUI.Models.ProductOperations.InventoryReservationFormViewModel

@{
    ViewData["Title"] = "Yeni Rezervasyon";
}

<div class="nk-content nk-content-fluid pm-form-page">
    <div class="container-fluid">
        <div class="nk-content-inner">
            <div class="nk-content-body">
                <partial name="_StatusMessage" />

                <div class="nk-block-head nk-block-head-sm">
                    <div class="nk-block-between">
                        <div class="nk-block-head-content">
                            <h3 class="nk-block-title page-title">Yeni Rezervasyon</h3>
                            <div class="nk-block-des text-soft">
                                <p>Rezervasyon kodu, süre ve kaynak bilgileriyle stok ayırımını oluşturun.</p>
                            </div>
                        </div>
                        <div class="nk-block-head-content">
                            <a asp-action="Reservations" class="btn btn-outline-light bg-white"><em class="icon ni ni-arrow-left"></em><span>Listeye Dön</span></a>
                        </div>
                    </div>
                </div>

                <div class="nk-block">
                <form method="post" asp-action="CreateReservation">
                    @Html.AntiForgeryToken()

                    <div class="card card-bordered pm-form-card">
                        <div class="card-inner border-bottom py-2">
                            <h6 class="title mb-0">Rezervasyon Bilgileri</h6>
                        </div>
                        <div class="card-inner">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <div class="row g-gs">
                                <div class="col-md-6">
                                    <label asp-for="ProductId" class="form-label"></label>
                                    <select asp-for="ProductId" class="form-select">
                                        <option value="">Ürün seçiniz</option>
                                        @foreach (var product in Model.Products)
                                        {
                                            <option value="@product.Id">@product.ProductCode - @product.Name</option>
                                        }
                                    </select>
                                    <span asp-validation-for="ProductId" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="WarehouseId" class="form-label"></label>
                                    <select asp-for="WarehouseId" class="form-select">
                                        <option value="">Depo seçiniz</option>
                                        @foreach (var warehouse in Model.Warehouses)
                                        {
                                            <option value="@warehouse.Id">@warehouse.Code - @warehouse.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Quantity" class="form-label"></label>
                                    <input asp-for="Quantity" class="form-control" type="number" step="0.01" min="0.0001" />
                                    <span asp-validation-for="Quantity" class="text-danger"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Status" class="form-label"></label>
                                    <input asp-for="Status" class="form-control" type="number" min="1" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="ReservedUntil" class="form-label"></label>
                                    <input asp-for="ReservedUntil" class="form-control" type="datetime-local" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ReservationCode" class="form-label"></label>
                                    <input asp-for="ReservationCode" class="form-control" />
                                    <span asp-validation-for="ReservationCode" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="SourceType" class="form-label"></label>
                                    <input asp-for="SourceType" class="form-control" />
                                </div>
                                <div class="col-12">
                                    <label asp-for="SourceId" class="form-label"></label>
                                    <input asp-for="SourceId" class="form-control" />
                                </div>
                            </div>

                            <div class="mt-4 pt-3 border-top d-flex flex-wrap justify-content-end gap-2">
                                <button type="submit" class="btn btn-primary">Kaydet</button>
                                <a asp-action="Reservations" class="btn btn-outline-light">Listeye Dön</a>
                            </div>
                        </div>
                    </div>
                </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
