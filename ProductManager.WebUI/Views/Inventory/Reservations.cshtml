@model ProductManager.WebUI.Models.ProductOperations.InventoryReservationListPageViewModel

@{
    ViewData["Title"] = "Stok Rezervasyonları";
}

<div class="nk-content">
    <div class="container-fluid">
        <div class="nk-content-inner">
            <div class="nk-content-body">
                <div class="nk-block-head nk-block-head-sm">
                    <div class="nk-block-between">
                        <div class="nk-block-head-content">
                            <h3 class="nk-block-title page-title">Stok Rezervasyonları</h3>
                            <div class="nk-block-des text-soft">
                                <p>Rezervasyon kayıtlarını ve durum güncellemelerini yönetin.</p>
                            </div>
                        </div>
                        <div class="nk-block-head-content">
                            <a href="#createReservationCard" class="btn btn-primary d-inline-flex">
                                <em class="icon ni ni-plus"></em>
                                <span>Yeni Rezervasyon</span>
                            </a>
                        </div>
                    </div>
                </div>

                @await Html.PartialAsync("_StatusMessage")

                <div class="nk-block">
                    <div class="card card-bordered mb-3">
                        <div class="card-inner">
                            <form method="get" class="row g-3 align-end">
                                <div class="col-lg-3">
                                    <div class="form-group">
                                        <label class="form-label" for="ProductId">Ürün ID</label>
                                        <input id="ProductId" name="ProductId" value="@Model.Filter.ProductId" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="form-group">
                                        <label class="form-label" for="WarehouseId">Depo ID</label>
                                        <input id="WarehouseId" name="WarehouseId" value="@Model.Filter.WarehouseId" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="form-group">
                                        <label class="form-label" for="Status">Durum</label>
                                        <input id="Status" name="Status" value="@Model.Filter.Status" class="form-control" type="number" />
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="form-group">
                                        <label class="form-label" for="ReservedUntilMin">Başlangıç</label>
                                        <input id="ReservedUntilMin" name="ReservedUntilMin" value="@Model.Filter.ReservedUntilMin?.ToString("yyyy-MM-dd")" class="form-control" type="date" />
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="form-group">
                                        <label class="form-label" for="ReservedUntilMax">Bitiş</label>
                                        <input id="ReservedUntilMax" name="ReservedUntilMax" value="@Model.Filter.ReservedUntilMax?.ToString("yyyy-MM-dd")" class="form-control" type="date" />
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="form-group">
                                        <label class="form-label" for="Take">Kayıt</label>
                                        <input id="Take" name="Take" value="@Model.Filter.Take" class="form-control" type="number" min="1" max="500" />
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="form-group">
                                        <button type="submit" class="btn btn-primary w-100">Filtrele</button>
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="form-group">
                                        <a asp-action="Reservations" class="btn btn-outline-light w-100">Temizle</a>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="card card-bordered mb-3">
                        <div class="card-inner p-0">
                            <div class="nk-tb-list nk-tb-ulist">
                                <div class="nk-tb-item nk-tb-head">
                                    <div class="nk-tb-col"><span>Kod</span></div>
                                    <div class="nk-tb-col"><span>Ürün</span></div>
                                    <div class="nk-tb-col tb-col-md"><span>Miktar</span></div>
                                    <div class="nk-tb-col tb-col-md"><span>Durum</span></div>
                                    <div class="nk-tb-col tb-col-md"><span>Bitiş</span></div>
                                    <div class="nk-tb-col nk-tb-col-tools text-end"></div>
                                </div>

                                @if (Model.Reservations.Count == 0)
                                {
                                    <div class="nk-tb-item">
                                        <div class="nk-tb-col">
                                            <span class="tb-sub">Kayıt bulunamadı.</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    foreach (var row in Model.Reservations)
                                    {
                                        var deleteFormId = $"delete-reservation-{row.Id:N}";
                                        var reservedUntil = row.ReservedUntil?.ToString("yyyy-MM-ddTHH:mm") ?? string.Empty;

                                        <div class="nk-tb-item">
                                            <div class="nk-tb-col"><span class="tb-sub">@row.ReservationCode</span></div>
                                            <div class="nk-tb-col"><span class="tb-sub">@row.ProductId</span></div>
                                            <div class="nk-tb-col tb-col-md"><span class="tb-sub">@row.Quantity</span></div>
                                            <div class="nk-tb-col tb-col-md"><span class="tb-sub">@row.Status</span></div>
                                            <div class="nk-tb-col tb-col-md"><span class="tb-sub">@(row.ReservedUntil?.ToString("dd.MM.yyyy HH:mm") ?? "-")</span></div>
                                            <div class="nk-tb-col nk-tb-col-tools">
                                                <ul class="nk-tb-actions gx-1 my-n1">
                                                    <li class="me-n1">
                                                        <div class="dropdown">
                                                            <a href="#" class="dropdown-toggle btn btn-icon btn-trigger" data-bs-toggle="dropdown">
                                                                <em class="icon ni ni-more-h"></em>
                                                            </a>
                                                            <div class="dropdown-menu dropdown-menu-end">
                                                                <ul class="link-list-opt no-bdr">
                                                                    <li>
                                                                        <a href="#updateStatusCard" onclick="setReservationStatusForm('@row.Id', '@row.Status', '@reservedUntil');">
                                                                            <em class="icon ni ni-edit"></em>
                                                                            <span>Durum Güncelle</span>
                                                                        </a>
                                                                    </li>
                                                                    <li>
                                                                        <a href="#" onclick="if (confirm('Bu rezervasyonu silmek istediğinize emin misiniz?')) { document.getElementById('@deleteFormId').submit(); } return false;">
                                                                            <em class="icon ni ni-trash"></em>
                                                                            <span>Sil</span>
                                                                        </a>
                                                                    </li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </li>
                                                </ul>

                                                <form id="@deleteFormId" asp-action="DeleteReservation" asp-route-id="@row.Id" method="post" class="d-none">
                                                    @Html.AntiForgeryToken()
                                                    <input asp-for="Filter.ProductId" type="hidden" />
                                                    <input asp-for="Filter.ProductVariantId" type="hidden" />
                                                    <input asp-for="Filter.WarehouseId" type="hidden" />
                                                    <input asp-for="Filter.Status" type="hidden" />
                                                    <input asp-for="Filter.ReservedUntilMin" type="hidden" />
                                                    <input asp-for="Filter.ReservedUntilMax" type="hidden" />
                                                    <input asp-for="Filter.Take" type="hidden" />
                                                </form>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div id="createReservationCard" class="card card-bordered mb-3">
                        <div class="card-inner border-bottom py-2">
                            <h6 class="title mb-0">Yeni Rezervasyon</h6>
                        </div>
                        <div class="card-inner">
                            <form method="post" asp-action="CreateReservation" class="row g-3">
                                @Html.AntiForgeryToken()

                                <input asp-for="Filter.ProductId" type="hidden" />
                                <input asp-for="Filter.ProductVariantId" type="hidden" />
                                <input asp-for="Filter.WarehouseId" type="hidden" />
                                <input asp-for="Filter.Status" type="hidden" />
                                <input asp-for="Filter.ReservedUntilMin" type="hidden" />
                                <input asp-for="Filter.ReservedUntilMax" type="hidden" />
                                <input asp-for="Filter.Take" type="hidden" />

                                <div asp-validation-summary="All" class="text-danger"></div>

                                <div class="col-lg-4">
                                    <label asp-for="CreateModal.ProductId" class="form-label"></label>
                                    <select asp-for="CreateModal.ProductId" class="form-select">
                                        <option value="">Ürün seçiniz</option>
                                        @foreach (var product in Model.CreateModal.Products)
                                        {
                                            <option value="@product.Id">@product.Name</option>
                                        }
                                    </select>
                                    <span asp-validation-for="CreateModal.ProductId" class="text-danger"></span>
                                </div>

                                <div class="col-lg-4">
                                    <label asp-for="CreateModal.WarehouseId" class="form-label"></label>
                                    <select asp-for="CreateModal.WarehouseId" class="form-select">
                                        <option value="">Depo seçiniz</option>
                                        @foreach (var warehouse in Model.CreateModal.Warehouses)
                                        {
                                            <option value="@warehouse.Id">@warehouse.Name</option>
                                        }
                                    </select>
                                    <span asp-validation-for="CreateModal.WarehouseId" class="text-danger"></span>
                                </div>

                                <div class="col-lg-4">
                                    <label asp-for="CreateModal.ReservationCode" class="form-label"></label>
                                    <input asp-for="CreateModal.ReservationCode" class="form-control" />
                                    <span asp-validation-for="CreateModal.ReservationCode" class="text-danger"></span>
                                </div>

                                <div class="col-lg-3">
                                    <label asp-for="CreateModal.Quantity" class="form-label"></label>
                                    <input asp-for="CreateModal.Quantity" class="form-control" type="number" step="0.01" min="0.0001" />
                                    <span asp-validation-for="CreateModal.Quantity" class="text-danger"></span>
                                </div>

                                <div class="col-lg-3">
                                    <label asp-for="CreateModal.Status" class="form-label"></label>
                                    <input asp-for="CreateModal.Status" class="form-control" type="number" min="1" />
                                    <span asp-validation-for="CreateModal.Status" class="text-danger"></span>
                                </div>

                                <div class="col-lg-3">
                                    <label asp-for="CreateModal.ReservedUntil" class="form-label"></label>
                                    <input asp-for="CreateModal.ReservedUntil" class="form-control" type="datetime-local" />
                                    <span asp-validation-for="CreateModal.ReservedUntil" class="text-danger"></span>
                                </div>

                                <div class="col-lg-3">
                                    <label asp-for="CreateModal.SourceType" class="form-label"></label>
                                    <input asp-for="CreateModal.SourceType" class="form-control" />
                                    <span asp-validation-for="CreateModal.SourceType" class="text-danger"></span>
                                </div>

                                <div class="col-lg-12">
                                    <label asp-for="CreateModal.SourceId" class="form-label"></label>
                                    <input asp-for="CreateModal.SourceId" class="form-control" />
                                    <span asp-validation-for="CreateModal.SourceId" class="text-danger"></span>
                                </div>

                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary">Rezervasyonu Kaydet</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div id="updateStatusCard" class="card card-bordered">
                        <div class="card-inner border-bottom py-2">
                            <h6 class="title mb-0">Rezervasyon Durumu Güncelle</h6>
                        </div>
                        <div class="card-inner">
                            <form method="post" asp-action="UpdateReservationStatus" class="row g-3">
                                @Html.AntiForgeryToken()

                                <input asp-for="Filter.ProductId" type="hidden" />
                                <input asp-for="Filter.ProductVariantId" type="hidden" />
                                <input asp-for="Filter.WarehouseId" type="hidden" />
                                <input asp-for="Filter.Status" type="hidden" />
                                <input asp-for="Filter.ReservedUntilMin" type="hidden" />
                                <input asp-for="Filter.ReservedUntilMax" type="hidden" />
                                <input asp-for="Filter.Take" type="hidden" />

                                <div asp-validation-summary="All" class="text-danger"></div>

                                <div class="col-lg-4">
                                    <label asp-for="UpdateStatusModal.Id" class="form-label"></label>
                                    <input asp-for="UpdateStatusModal.Id" class="form-control" id="updateReservationId" />
                                    <span asp-validation-for="UpdateStatusModal.Id" class="text-danger"></span>
                                </div>

                                <div class="col-lg-4">
                                    <label asp-for="UpdateStatusModal.Status" class="form-label"></label>
                                    <input asp-for="UpdateStatusModal.Status" class="form-control" type="number" min="1" id="updateReservationStatus" />
                                    <span asp-validation-for="UpdateStatusModal.Status" class="text-danger"></span>
                                </div>

                                <div class="col-lg-4">
                                    <label asp-for="UpdateStatusModal.ReservedUntil" class="form-label"></label>
                                    <input asp-for="UpdateStatusModal.ReservedUntil" class="form-control" type="datetime-local" id="updateReservationReservedUntil" />
                                    <span asp-validation-for="UpdateStatusModal.ReservedUntil" class="text-danger"></span>
                                </div>

                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary">Durumu Güncelle</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function setReservationStatusForm(id, status, reservedUntil) {
            var idInput = document.getElementById('updateReservationId');
            var statusInput = document.getElementById('updateReservationStatus');
            var reservedUntilInput = document.getElementById('updateReservationReservedUntil');

            if (idInput) idInput.value = id || '';
            if (statusInput) statusInput.value = status || '';
            if (reservedUntilInput) reservedUntilInput.value = reservedUntil || '';
        }
    </script>
}
