@model ProductManager.WebUI.Models.ProductOperations.InventoryReservationListPageViewModel

@{
    ViewData["Title"] = "Stok Rezervasyonları";
}

<div class="nk-content nk-content-fluid pm-list-page">
    <div class="container-fluid">
        <div class="nk-content-inner">
            <div class="nk-content-body">
                <partial name="_StatusMessage" />

                <div class="nk-block-head nk-block-head-sm">
                    <div class="nk-block-between">
                        <div class="nk-block-head-content">
                            <h3 class="nk-block-title page-title">Stok Rezervasyonları</h3>
                            <div class="nk-block-des text-soft">
                                <p>Sipariş rezervlerini durum ve süre bazlı takip edin.</p>
                            </div>
                        </div>
                        <div class="nk-block-head-content">
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createReservationModal">
                                <em class="icon ni ni-plus"></em><span>Yeni Rezervasyon</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="nk-block">
                    <div class="card card-bordered mb-3 pm-filter-card">
                        <div class="card-inner">
                            <form method="get" class="row g-gs align-items-end pm-filter-form">
                                <div class="col-md-6 col-lg-3">
                                    <label class="form-label" for="productId">Ürün ID</label>
                                    <input id="productId" name="ProductId" value="@Model.Filter.ProductId" class="form-control" />
                                </div>
                                <div class="col-md-6 col-lg-3">
                                    <label class="form-label" for="warehouseId">Depo ID</label>
                                    <input id="warehouseId" name="WarehouseId" value="@Model.Filter.WarehouseId" class="form-control" />
                                </div>
                                <div class="col-md-4 col-lg-2">
                                    <label class="form-label" for="status">Durum</label>
                                    <input id="status" name="Status" value="@Model.Filter.Status" class="form-control" type="number" />
                                </div>
                                <div class="col-md-4 col-lg-2">
                                    <label class="form-label" for="reservedUntilMin">Başlangıç</label>
                                    <input id="reservedUntilMin" name="ReservedUntilMin" value="@Model.Filter.ReservedUntilMin?.ToString("yyyy-MM-dd")" class="form-control" type="date" />
                                </div>
                                <div class="col-md-4 col-lg-2">
                                    <label class="form-label" for="reservedUntilMax">Bitiş</label>
                                    <input id="reservedUntilMax" name="ReservedUntilMax" value="@Model.Filter.ReservedUntilMax?.ToString("yyyy-MM-dd")" class="form-control" type="date" />
                                </div>
                                <div class="col-md-4 col-lg-2">
                                    <label class="form-label" for="take">Kayıt</label>
                                    <input id="take" name="Take" value="@Model.Filter.Take" class="form-control" type="number" min="1" max="500" />
                                </div>
                                <div class="col-12 d-flex flex-wrap gap-2">
                                    <button type="submit" class="btn btn-primary">Filtrele</button>
                                    <a asp-action="Reservations" class="btn btn-outline-light">Temizle</a>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="card card-bordered card-stretch pm-table-card">
                    <div class="card-inner border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="title mb-0">Rezervasyon Listesi</h6>
                        <span class="text-soft small">Toplam: @Model.Reservations.Count</span>
                    </div>
                    <div class="card-inner p-0">
                        <div class="table-responsive">
                            <table class="table table-tranx mb-0 pm-table">
                                <thead>
                                    <tr class="tb-tnx-head">
                                        <th>Kod</th>
                                        <th>Ürün</th>
                                        <th>Miktar</th>
                                        <th>Durum</th>
                                        <th>Bitiş</th>
                                        <th class="text-end">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @if (Model.Reservations.Count == 0)
                                {
                                    <tr><td colspan="6" class="text-center py-4">Kayıt bulunamadı.</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in Model.Reservations)
                                    {
                                        <tr>
                                            <td><span class="tb-sub">@row.ReservationCode</span></td>
                                            <td>@row.ProductId</td>
                                            <td>@row.Quantity</td>
                                            <td>
                                                <span class="badge bg-info">@row.Status</span>
                                            </td>
                                            <td><span class="tb-sub">@(row.ReservedUntil?.ToString("yyyy-MM-dd HH:mm") ?? "-")</span></td>
                                            <td class="text-end">
                                                <div class="d-inline-flex gap-2">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#updateReservationStatusModal"
                                                            data-edit-reservation-status
                                                            data-id="@row.Id"
                                                            data-status="@row.Status"
                                                            data-reserved-until="@(row.ReservedUntil?.ToString("yyyy-MM-ddTHH:mm") ?? string.Empty)">
                                                        Güncelle
                                                    </button>
                                                    <form asp-action="DeleteReservation" asp-route-id="@row.Id" method="post" onsubmit="return confirm('Rezervasyon silinsin mi?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="Filter.ProductId" value="@Model.Filter.ProductId" />
                                                        <input type="hidden" name="Filter.ProductVariantId" value="@Model.Filter.ProductVariantId" />
                                                        <input type="hidden" name="Filter.WarehouseId" value="@Model.Filter.WarehouseId" />
                                                        <input type="hidden" name="Filter.Status" value="@Model.Filter.Status" />
                                                        <input type="hidden" name="Filter.ReservedUntilMin" value="@Model.Filter.ReservedUntilMin" />
                                                        <input type="hidden" name="Filter.ReservedUntilMax" value="@Model.Filter.ReservedUntilMax" />
                                                        <input type="hidden" name="Filter.Take" value="@Model.Filter.Take" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                </div>

                <div class="modal fade" id="createReservationModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg" role="document">
                        <div class="modal-content pm-modal">
                            <form method="post" asp-action="CreateReservation">
                                @Html.AntiForgeryToken()
                                <input asp-for="Filter.ProductId" type="hidden" />
                                <input asp-for="Filter.ProductVariantId" type="hidden" />
                                <input asp-for="Filter.WarehouseId" type="hidden" />
                                <input asp-for="Filter.Status" type="hidden" />
                                <input asp-for="Filter.ReservedUntilMin" type="hidden" />
                                <input asp-for="Filter.ReservedUntilMax" type="hidden" />
                                <input asp-for="Filter.Take" type="hidden" />

                                <div class="modal-header">
                                    <h5 class="modal-title">Yeni Rezervasyon</h5>
                                    <a href="#" class="close" data-bs-dismiss="modal" aria-label="Close">
                                        <em class="icon ni ni-cross"></em>
                                    </a>
                                </div>

                                <div class="modal-body">
                                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                                    <div class="row g-gs">
                                        <div class="col-md-6">
                                            <label asp-for="CreateModal.ProductId" class="form-label"></label>
                                            <select asp-for="CreateModal.ProductId" class="form-select">
                                                <option value="">Ürün seçiniz</option>
                                                @foreach (var product in Model.CreateModal.Products)
                                                {
                                                    <option value="@product.Id">@product.ProductCode - @product.Name</option>
                                                }
                                            </select>
                                            <span asp-validation-for="CreateModal.ProductId" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="CreateModal.WarehouseId" class="form-label"></label>
                                            <select asp-for="CreateModal.WarehouseId" class="form-select">
                                                <option value="">Depo seçiniz</option>
                                                @foreach (var warehouse in Model.CreateModal.Warehouses)
                                                {
                                                    <option value="@warehouse.Id">@warehouse.Code - @warehouse.Name</option>
                                                }
                                            </select>
                                            <span asp-validation-for="CreateModal.WarehouseId" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="CreateModal.Quantity" class="form-label"></label>
                                            <input asp-for="CreateModal.Quantity" class="form-control" type="number" step="0.01" min="0.0001" />
                                            <span asp-validation-for="CreateModal.Quantity" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="CreateModal.Status" class="form-label"></label>
                                            <input asp-for="CreateModal.Status" class="form-control" type="number" min="1" />
                                            <span asp-validation-for="CreateModal.Status" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="CreateModal.ReservedUntil" class="form-label"></label>
                                            <input asp-for="CreateModal.ReservedUntil" class="form-control" type="datetime-local" />
                                            <span asp-validation-for="CreateModal.ReservedUntil" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="CreateModal.ReservationCode" class="form-label"></label>
                                            <input asp-for="CreateModal.ReservationCode" class="form-control" />
                                            <span asp-validation-for="CreateModal.ReservationCode" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="CreateModal.SourceType" class="form-label"></label>
                                            <input asp-for="CreateModal.SourceType" class="form-control" />
                                            <span asp-validation-for="CreateModal.SourceType" class="text-danger"></span>
                                        </div>
                                        <div class="col-12">
                                            <label asp-for="CreateModal.SourceId" class="form-label"></label>
                                            <input asp-for="CreateModal.SourceId" class="form-control" />
                                            <span asp-validation-for="CreateModal.SourceId" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="modal-footer bg-light">
                                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Vazgeç</button>
                                    <button type="submit" class="btn btn-primary">Kaydet</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="updateReservationStatusModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content pm-modal">
                            <form method="post" asp-action="UpdateReservationStatus">
                                @Html.AntiForgeryToken()
                                <input asp-for="Filter.ProductId" type="hidden" />
                                <input asp-for="Filter.ProductVariantId" type="hidden" />
                                <input asp-for="Filter.WarehouseId" type="hidden" />
                                <input asp-for="Filter.Status" type="hidden" />
                                <input asp-for="Filter.ReservedUntilMin" type="hidden" />
                                <input asp-for="Filter.ReservedUntilMax" type="hidden" />
                                <input asp-for="Filter.Take" type="hidden" />
                                <input asp-for="UpdateStatusModal.Id" type="hidden" id="updateReservationId" />

                                <div class="modal-header">
                                    <h5 class="modal-title">Rezervasyon Durumu Güncelle</h5>
                                    <a href="#" class="close" data-bs-dismiss="modal" aria-label="Close">
                                        <em class="icon ni ni-cross"></em>
                                    </a>
                                </div>

                                <div class="modal-body">
                                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                                    <div class="row g-gs">
                                        <div class="col-12">
                                            <label asp-for="UpdateStatusModal.Status" class="form-label"></label>
                                            <input asp-for="UpdateStatusModal.Status" class="form-control" type="number" min="1" id="updateReservationStatus" />
                                            <span asp-validation-for="UpdateStatusModal.Status" class="text-danger"></span>
                                        </div>
                                        <div class="col-12">
                                            <label asp-for="UpdateStatusModal.ReservedUntil" class="form-label"></label>
                                            <input asp-for="UpdateStatusModal.ReservedUntil" class="form-control" type="datetime-local" id="updateReservationReservedUntil" />
                                            <span asp-validation-for="UpdateStatusModal.ReservedUntil" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="modal-footer bg-light">
                                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Vazgeç</button>
                                    <button type="submit" class="btn btn-primary">Güncelle</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var updateReservationIdInput = document.getElementById('updateReservationId');
            var updateReservationStatusInput = document.getElementById('updateReservationStatus');
            var updateReservationReservedUntilInput = document.getElementById('updateReservationReservedUntil');

            var updateButtons = document.querySelectorAll('[data-edit-reservation-status]');
            updateButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    if (updateReservationIdInput) {
                        updateReservationIdInput.value = button.getAttribute('data-id') || '';
                    }

                    if (updateReservationStatusInput) {
                        updateReservationStatusInput.value = button.getAttribute('data-status') || '';
                    }

                    if (updateReservationReservedUntilInput) {
                        updateReservationReservedUntilInput.value = button.getAttribute('data-reserved-until') || '';
                    }
                });
            });

            var shouldOpenCreateModal = @Model.OpenCreateModal.ToString().ToLowerInvariant();
            var shouldOpenUpdateModal = @Model.OpenUpdateStatusModal.ToString().ToLowerInvariant();

            var createModalElement = document.getElementById('createReservationModal');
            var updateModalElement = document.getElementById('updateReservationStatusModal');

            if (createModalElement && shouldOpenCreateModal && window.bootstrap) {
                window.bootstrap.Modal.getOrCreateInstance(createModalElement).show();
            }

            if (updateModalElement && shouldOpenUpdateModal && window.bootstrap) {
                window.bootstrap.Modal.getOrCreateInstance(updateModalElement).show();
            }
        });
    </script>
}
