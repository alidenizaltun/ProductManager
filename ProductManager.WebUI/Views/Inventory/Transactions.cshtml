@model ProductManager.WebUI.Models.ProductOperations.InventoryTransactionListPageViewModel

@{
    ViewData["Title"] = "Stok Hareketleri";
}

<div class="nk-content">
    <div class="container-fluid">
        <div class="nk-content-inner">
            <div class="nk-content-body">
                <div class="nk-block-head nk-block-head-sm">
                    <div class="nk-block-between">
                        <div class="nk-block-head-content">
                            <h3 class="nk-block-title page-title">Stok Hareketleri</h3>
                            <div class="nk-block-des text-soft">
                                <p>Giriş, çıkış ve düzeltme işlemlerini tek akışta yönetin.</p>
                            </div>
                        </div>
                        <div class="nk-block-head-content">
                            <a href="#createTransactionCard" class="btn btn-primary d-inline-flex">
                                <em class="icon ni ni-plus"></em>
                                <span>Yeni Hareket</span>
                            </a>
                        </div>
                    </div>
                </div>

                @await Html.PartialAsync("_StatusMessage")

                <div class="nk-block">
                    <div class="card card-bordered mb-3">
                        <div class="card-inner">
                            <form method="get" class="row g-3 align-end">
                                <div class="col-lg-3">
                                    <div class="form-group">
                                        <label class="form-label" for="ProductId">Ürün ID</label>
                                        <input id="ProductId" name="ProductId" value="@Model.Filter.ProductId" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="form-group">
                                        <label class="form-label" for="WarehouseId">Depo ID</label>
                                        <input id="WarehouseId" name="WarehouseId" value="@Model.Filter.WarehouseId" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="form-group">
                                        <label class="form-label" for="TransactionType">Tip</label>
                                        <input id="TransactionType" name="TransactionType" value="@Model.Filter.TransactionType" class="form-control" type="number" />
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="form-group">
                                        <label class="form-label" for="DateFrom">Başlangıç</label>
                                        <input id="DateFrom" name="DateFrom" value="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")" class="form-control" type="date" />
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="form-group">
                                        <label class="form-label" for="DateTo">Bitiş</label>
                                        <input id="DateTo" name="DateTo" value="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")" class="form-control" type="date" />
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="form-group">
                                        <label class="form-label" for="Take">Kayıt</label>
                                        <input id="Take" name="Take" value="@Model.Filter.Take" class="form-control" type="number" min="1" max="500" />
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="form-group">
                                        <button type="submit" class="btn btn-primary w-100">Filtrele</button>
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="form-group">
                                        <a asp-action="Transactions" class="btn btn-outline-light w-100">Temizle</a>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="card card-bordered mb-3">
                        <div class="card-inner p-0">
                            <div class="nk-tb-list nk-tb-ulist">
                                <div class="nk-tb-item nk-tb-head">
                                    <div class="nk-tb-col"><span>Ürün</span></div>
                                    <div class="nk-tb-col"><span>Depo</span></div>
                                    <div class="nk-tb-col tb-col-md"><span>Tip</span></div>
                                    <div class="nk-tb-col tb-col-md"><span>Miktar</span></div>
                                    <div class="nk-tb-col tb-col-md"><span>Maliyet</span></div>
                                    <div class="nk-tb-col tb-col-md"><span>Tarih</span></div>
                                </div>

                                @if (Model.Transactions.Count == 0)
                                {
                                    <div class="nk-tb-item">
                                        <div class="nk-tb-col">
                                            <span class="tb-sub">Kayıt bulunamadı.</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    foreach (var row in Model.Transactions)
                                    {
                                        <div class="nk-tb-item">
                                            <div class="nk-tb-col"><span class="tb-sub">@row.ProductId</span></div>
                                            <div class="nk-tb-col"><span class="tb-sub">@(row.WarehouseId?.ToString() ?? "-")</span></div>
                                            <div class="nk-tb-col tb-col-md"><span class="tb-sub">@row.TransactionType</span></div>
                                            <div class="nk-tb-col tb-col-md"><span class="tb-sub">@row.Quantity</span></div>
                                            <div class="nk-tb-col tb-col-md"><span class="tb-sub">@(row.UnitCost?.ToString() ?? "-")</span></div>
                                            <div class="nk-tb-col tb-col-md"><span class="tb-sub">@row.OccurredAt.ToString("dd.MM.yyyy HH:mm")</span></div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div id="createTransactionCard" class="card card-bordered">
                        <div class="card-inner border-bottom py-2">
                            <h6 class="title mb-0">Yeni Stok Hareketi</h6>
                        </div>
                        <div class="card-inner">
                            <form method="post" asp-action="CreateTransaction" class="row g-3">
                                @Html.AntiForgeryToken()

                                <input asp-for="Filter.ProductId" type="hidden" />
                                <input asp-for="Filter.ProductVariantId" type="hidden" />
                                <input asp-for="Filter.WarehouseId" type="hidden" />
                                <input asp-for="Filter.TransactionType" type="hidden" />
                                <input asp-for="Filter.DateFrom" type="hidden" />
                                <input asp-for="Filter.DateTo" type="hidden" />
                                <input asp-for="Filter.Take" type="hidden" />

                                <div asp-validation-summary="All" class="text-danger"></div>

                                <div class="col-lg-4">
                                    <label asp-for="CreateModal.ProductId" class="form-label"></label>
                                    <select asp-for="CreateModal.ProductId" class="form-select">
                                        <option value="">Ürün seçiniz</option>
                                        @foreach (var product in Model.CreateModal.Products)
                                        {
                                            <option value="@product.Id">@product.ProductCode - @product.Name</option>
                                        }
                                    </select>
                                    <span asp-validation-for="CreateModal.ProductId" class="text-danger"></span>
                                </div>

                                <div class="col-lg-4">
                                    <label asp-for="CreateModal.WarehouseId" class="form-label"></label>
                                    <select asp-for="CreateModal.WarehouseId" class="form-select">
                                        <option value="">Depo seçiniz</option>
                                        @foreach (var warehouse in Model.CreateModal.Warehouses)
                                        {
                                            <option value="@warehouse.Id">@warehouse.Code - @warehouse.Name</option>
                                        }
                                    </select>
                                    <span asp-validation-for="CreateModal.WarehouseId" class="text-danger"></span>
                                </div>

                                <div class="col-lg-4">
                                    <label asp-for="CreateModal.TransactionType" class="form-label"></label>
                                    <input asp-for="CreateModal.TransactionType" class="form-control" type="number" min="1" />
                                    <span asp-validation-for="CreateModal.TransactionType" class="text-danger"></span>
                                </div>

                                <div class="col-lg-4">
                                    <label asp-for="CreateModal.Quantity" class="form-label"></label>
                                    <input asp-for="CreateModal.Quantity" class="form-control" type="number" step="0.01" min="0.0001" />
                                    <span asp-validation-for="CreateModal.Quantity" class="text-danger"></span>
                                </div>

                                <div class="col-lg-4">
                                    <label asp-for="CreateModal.UnitCost" class="form-label"></label>
                                    <input asp-for="CreateModal.UnitCost" class="form-control" type="number" step="0.01" />
                                    <span asp-validation-for="CreateModal.UnitCost" class="text-danger"></span>
                                </div>

                                <div class="col-lg-4">
                                    <label asp-for="CreateModal.OccurredAt" class="form-label"></label>
                                    <input asp-for="CreateModal.OccurredAt" class="form-control" type="datetime-local" />
                                    <span asp-validation-for="CreateModal.OccurredAt" class="text-danger"></span>
                                </div>

                                <div class="col-lg-6">
                                    <label asp-for="CreateModal.ReferenceType" class="form-label"></label>
                                    <input asp-for="CreateModal.ReferenceType" class="form-control" />
                                </div>

                                <div class="col-lg-6">
                                    <label asp-for="CreateModal.ReferenceNumber" class="form-label"></label>
                                    <input asp-for="CreateModal.ReferenceNumber" class="form-control" />
                                </div>

                                <div class="col-lg-12">
                                    <label asp-for="CreateModal.Note" class="form-label"></label>
                                    <textarea asp-for="CreateModal.Note" class="form-control" rows="2"></textarea>
                                </div>

                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary">Hareketi Kaydet</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
