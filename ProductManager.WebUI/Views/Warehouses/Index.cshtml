@model ProductManager.WebUI.Models.ProductOperations.WarehouseListPageViewModel

@{
    ViewData["Title"] = "Depolar";
}

<div class="nk-content">
    <div class="container-fluid">
        <div class="nk-content-inner">
            <div class="nk-content-body">
                <div class="nk-block-head nk-block-head-sm">
                    <div class="nk-block-between">
                        <div class="nk-block-head-content">
                            <h3 class="nk-block-title page-title">Depolar</h3>
                            <div class="nk-block-des text-soft">
                                <p>Depo lokasyonlarını ve aktiflik durumlarını yönetin.</p>
                            </div>
                        </div>
                        <div class="nk-block-head-content">
                            <a asp-action="Create" class="btn btn-primary d-inline-flex">
                                <em class="icon ni ni-plus"></em>
                                <span>Yeni Depo</span>
                            </a>
                        </div>
                    </div>
                </div>

                @await Html.PartialAsync("_StatusMessage")

                <div class="nk-block">
                    <div class="card card-bordered mb-3">
                        <div class="card-inner">
                            <form method="get" class="row g-3 align-end">
                                <div class="col-lg-3">
                                    <div class="form-group">
                                        <label class="form-label" for="includeInactive">Listeleme</label>
                                        <div class="form-control-wrap">
                                            <select id="includeInactive" name="includeInactive" class="form-select">
                                                <option value="false" selected="@(!Model.IncludeInactive)">Sadece aktifler</option>
                                                <option value="true" selected="@(Model.IncludeInactive)">Tüm kayıtlar</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-2">
                                    <div class="form-group">
                                        <button type="submit" class="btn btn-primary w-100">Uygula</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="card card-bordered">
                        <div class="card-inner p-0">
                            <div class="nk-tb-list nk-tb-ulist">
                                <div class="nk-tb-item nk-tb-head">
                                    <div class="nk-tb-col"><span>Kod</span></div>
                                    <div class="nk-tb-col tb-col-sm"><span>Depo</span></div>
                                    <div class="nk-tb-col tb-col-md"><span>Şehir</span></div>
                                    <div class="nk-tb-col tb-col-md"><span>Ülke</span></div>
                                    <div class="nk-tb-col tb-col-md"><span>Durum</span></div>
                                    <div class="nk-tb-col nk-tb-col-tools text-end"></div>
                                </div>

                                @if (Model.Warehouses.Count == 0)
                                {
                                    <div class="nk-tb-item">
                                        <div class="nk-tb-col">
                                            <span class="tb-sub">Kayıt bulunamadı.</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    foreach (var row in Model.Warehouses)
                                    {
                                        var deleteFormId = $"delete-warehouse-{row.Id:N}";

                                        <div class="nk-tb-item">
                                            <div class="nk-tb-col">
                                                <span class="tb-sub">@row.Code</span>
                                            </div>
                                            <div class="nk-tb-col tb-col-sm">
                                                <span class="tb-lead">@row.Name</span>
                                                @if (!string.IsNullOrWhiteSpace(row.Address))
                                                {
                                                    <span class="tb-sub d-block">@row.Address</span>
                                                }
                                            </div>
                                            <div class="nk-tb-col tb-col-md">
                                                <span class="tb-sub">@(string.IsNullOrWhiteSpace(row.City) ? "-" : row.City)</span>
                                            </div>
                                            <div class="nk-tb-col tb-col-md">
                                                <span class="tb-sub">@(string.IsNullOrWhiteSpace(row.Country) ? "-" : row.Country)</span>
                                            </div>
                                            <div class="nk-tb-col tb-col-md">
                                                @if (row.IsActive)
                                                {
                                                    <span class="badge badge-dim bg-success">Aktif</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-dim bg-light">Pasif</span>
                                                }
                                            </div>
                                            <div class="nk-tb-col nk-tb-col-tools">
                                                <ul class="nk-tb-actions gx-1 my-n1">
                                                    <li class="me-n1">
                                                        <div class="dropdown">
                                                            <a href="#" class="dropdown-toggle btn btn-icon btn-trigger" data-bs-toggle="dropdown">
                                                                <em class="icon ni ni-more-h"></em>
                                                            </a>
                                                            <div class="dropdown-menu dropdown-menu-end">
                                                                <ul class="link-list-opt no-bdr">
                                                                    <li>
                                                                        <a asp-action="Edit" asp-route-id="@row.Id">
                                                                            <em class="icon ni ni-edit"></em>
                                                                            <span>Düzenle</span>
                                                                        </a>
                                                                    </li>
                                                                    <li>
                                                                        <a href="#" onclick="if (confirm('Bu depoyu silmek istediğinize emin misiniz?')) { document.getElementById('@deleteFormId').submit(); } return false;">
                                                                            <em class="icon ni ni-trash"></em>
                                                                            <span>Sil</span>
                                                                        </a>
                                                                    </li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </li>
                                                </ul>

                                                <form id="@deleteFormId" asp-action="Delete" asp-route-id="@row.Id" method="post" class="d-none">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="includeInactive" value="@Model.IncludeInactive.ToString().ToLowerInvariant()" />
                                                </form>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
