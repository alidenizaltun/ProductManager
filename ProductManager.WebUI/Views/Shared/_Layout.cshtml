<!DOCTYPE html>
<html lang="zxx" class="js">

<head>
    <base href="/">
    <meta charset="utf-8">
    <meta name="author" content="Softnio">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="A powerful and conceptual apps base dashboard template that especially build for developers and programmers.">
    
    <!-- Fav Icon  -->
    <link rel="shortcut icon" href="~/images/favicon.png" asp-append-version="true">

    <!-- Page Title  -->
    <title>@(ViewData["Title"] is string pageTitle ? $"{pageTitle} | Ürün Yönetimi" : "Ürün Yönetimi")</title>

    <!-- StyleSheets  -->
    <link rel="stylesheet" href="~/assets/css/dashlite.min.css" asp-append-version="true">
    <link id="skin-default" rel="stylesheet" href="~/assets/css/theme.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/productmanager-theme.css" asp-append-version="true">
</head>

<body class="nk-body npc-default has-apps-sidebar has-sidebar ">
    @await Component.InvokeAsync("Header")

    <div class="nk-main ">
        <div class="nk-wrap ">
            @await Component.InvokeAsync("Menu")

            @if (ViewData["Breadcrumb"] is string breadcrumb && !string.IsNullOrWhiteSpace(breadcrumb))
            {
                <div class="nk-content pb-0">
                    <div class="container-fluid">
                        <div class="nk-content-inner">
                            <div class="nk-content-body">
                                <ul class="breadcrumb breadcrumb-arrow">
                                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Anasayfa</a></li>
                                    <li class="breadcrumb-item active">@breadcrumb</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @RenderBody()

            @await Component.InvokeAsync("Footer")

        </div>
    </div>

    <!-- JavaScript -->
    <script src="~/assets/js/bundle.js" asp-append-version="true" defer></script>
    <script src="~/assets/js/scripts.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
