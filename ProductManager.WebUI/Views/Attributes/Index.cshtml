@model ProductManager.WebUI.Models.ProductOperations.AttributeDefinitionListPageViewModel

@{
    ViewData["Title"] = "Özellik Tanımları";
}

<div class="nk-content">
    <div class="container-fluid">
        <div class="nk-content-inner">
            <div class="nk-content-body">
                <div class="nk-block-head nk-block-head-sm">
                    <div class="nk-block-between">
                        <div class="nk-block-head-content">
                            <h3 class="nk-block-title page-title">Özellik Tanımları</h3>
                            <div class="nk-block-des text-soft">
                                <p>Ürün özellik anahtarlarını, veri tiplerini ve zorunluluk kurallarını yönetin.</p>
                            </div>
                        </div>
                        <div class="nk-block-head-content">
                            <a asp-action="Create" class="btn btn-primary d-inline-flex">
                                <em class="icon ni ni-plus"></em>
                                <span>Yeni Özellik</span>
                            </a>
                        </div>
                    </div>
                </div>

                @await Html.PartialAsync("_StatusMessage")

                <div class="nk-block">
                    <div class="card card-bordered">
                        <div class="card-inner p-0">
                            <div class="nk-tb-list nk-tb-ulist">
                                <div class="nk-tb-item nk-tb-head">
                                    <div class="nk-tb-col"><span>Anahtar</span></div>
                                    <div class="nk-tb-col tb-col-sm"><span>Görünen Ad</span></div>
                                    <div class="nk-tb-col tb-col-md"><span>Veri Tipi</span></div>
                                    <div class="nk-tb-col tb-col-md"><span>Zorunlu</span></div>
                                    <div class="nk-tb-col tb-col-md"><span>Filtre</span></div>
                                    <div class="nk-tb-col tb-col-md"><span>Varyant Ekseni</span></div>
                                    <div class="nk-tb-col nk-tb-col-tools text-end"></div>
                                </div>

                                @if (Model.Attributes.Count == 0)
                                {
                                    <div class="nk-tb-item">
                                        <div class="nk-tb-col">
                                            <span class="tb-sub">Kayıt bulunamadı.</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    foreach (var row in Model.Attributes)
                                    {
                                        var deleteFormId = $"delete-attribute-{row.Id:N}";

                                        <div class="nk-tb-item">
                                            <div class="nk-tb-col">
                                                <span class="tb-lead">@row.Key</span>
                                            </div>
                                            <div class="nk-tb-col tb-col-sm">
                                                <span class="tb-sub">@row.DisplayName</span>
                                            </div>
                                            <div class="nk-tb-col tb-col-md">
                                                <span class="tb-sub">@row.DataType</span>
                                            </div>
                                            <div class="nk-tb-col tb-col-md">
                                                <span class="tb-sub">@(row.IsRequired ? "Evet" : "Hayır")</span>
                                            </div>
                                            <div class="nk-tb-col tb-col-md">
                                                <span class="tb-sub">@(row.IsFilterable ? "Evet" : "Hayır")</span>
                                            </div>
                                            <div class="nk-tb-col tb-col-md">
                                                <span class="tb-sub">@(row.IsVariantAxis ? "Evet" : "Hayır")</span>
                                            </div>
                                            <div class="nk-tb-col nk-tb-col-tools">
                                                <ul class="nk-tb-actions gx-1 my-n1">
                                                    <li class="me-n1">
                                                        <div class="dropdown">
                                                            <a href="#" class="dropdown-toggle btn btn-icon btn-trigger" data-bs-toggle="dropdown">
                                                                <em class="icon ni ni-more-h"></em>
                                                            </a>
                                                            <div class="dropdown-menu dropdown-menu-end">
                                                                <ul class="link-list-opt no-bdr">
                                                                    <li>
                                                                        <a asp-action="Edit" asp-route-id="@row.Id">
                                                                            <em class="icon ni ni-edit"></em>
                                                                            <span>Düzenle</span>
                                                                        </a>
                                                                    </li>
                                                                    <li>
                                                                        <a href="#" onclick="if (confirm('Bu özelliği silmek istediğinize emin misiniz?')) { document.getElementById('@deleteFormId').submit(); } return false;">
                                                                            <em class="icon ni ni-trash"></em>
                                                                            <span>Sil</span>
                                                                        </a>
                                                                    </li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </li>
                                                </ul>

                                                <form id="@deleteFormId" asp-action="Delete" asp-route-id="@row.Id" method="post" class="d-none">
                                                    @Html.AntiForgeryToken()
                                                </form>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
