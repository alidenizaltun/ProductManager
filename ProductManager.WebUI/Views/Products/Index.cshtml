@model ProductManager.WebUI.Models.Products.ProductIndexViewModel

@{
    ViewData["Title"] = "Ürünler";

    string kindLabel(int value) =>
        Model.KindLabels.TryGetValue(value, out var label) ? label : $"Bilinmiyor ({value})";

    string statusLabel(int value) =>
        Model.StatusLabels.TryGetValue(value, out var label) ? label : $"Bilinmiyor ({value})";

    string statusClass(int value) => value switch
    {
        2 => "text-success",
        1 => "text-warning",
        3 => "text-danger",
        4 => "text-soft",
        _ => "text-soft"
    };
}

<div class="nk-content">
    <div class="container-fluid">
        <div class="nk-content-inner">
            <div class="nk-content-body">
                <div class="nk-block-head nk-block-head-sm">
                    <div class="nk-block-between">
                        <div class="nk-block-head-content">
                            <h3 class="nk-block-title page-title">Ürün Yönetimi</h3>
                            <div class="nk-block-des text-soft">
                                <p>Ürün listeleme, filtreleme, güncelleme ve silme işlemlerini tek ekrandan yönetin.</p>
                            </div>
                        </div>
                        <div class="nk-block-head-content">
                            <a asp-action="Create" class="btn btn-primary d-inline-flex">
                                <em class="icon ni ni-plus"></em>
                                <span>Yeni Ürün Ekle</span>
                            </a>
                        </div>
                    </div>
                </div>

                @await Html.PartialAsync("_StatusMessage")

                <div class="nk-block">
                    <div class="card card-bordered">
                        <div class="card-inner">
                            <form asp-action="Index" method="get">
                                <div class="row g-3 align-end">
                                    <div class="col-lg-4">
                                        <div class="form-group">
                                            <label asp-for="Search" class="form-label"></label>
                                            <div class="form-control-wrap">
                                                <input asp-for="Search" class="form-control" placeholder="Ürün kodu veya adı" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-2">
                                        <div class="form-group">
                                            <label asp-for="Kind" class="form-label"></label>
                                            <div class="form-control-wrap">
                                                <select asp-for="Kind" asp-items="Model.KindOptions" class="form-select"></select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-2">
                                        <div class="form-group">
                                            <label asp-for="Status" class="form-label"></label>
                                            <div class="form-control-wrap">
                                                <select asp-for="Status" asp-items="Model.StatusOptions" class="form-select"></select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-2">
                                        <div class="form-group">
                                            <label asp-for="IsActive" class="form-label"></label>
                                            <div class="form-control-wrap">
                                                <select asp-for="IsActive" asp-items="Model.ActivityOptions" class="form-select"></select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-1">
                                        <div class="form-group">
                                            <label asp-for="Take" class="form-label"></label>
                                            <div class="form-control-wrap">
                                                <input asp-for="Take" class="form-control" min="1" max="200" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-1">
                                        <div class="form-group">
                                            <button type="submit" class="btn btn-primary w-100">Filtrele</button>
                                        </div>
                                    </div>
                                    <div class="col-lg-2">
                                        <div class="form-group">
                                            <a asp-action="Index" class="btn btn-outline-light w-100">Temizle</a>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="nk-block">
                    <div class="card card-bordered">
                        <div class="card-inner-group">
                            <div class="card-inner p-0">
                                <div class="nk-tb-list nk-tb-ulist">
                                    <div class="nk-tb-item nk-tb-head">
                                        <div class="nk-tb-col tb-col-sm"><span>Ürün</span></div>
                                        <div class="nk-tb-col"><span>Kod</span></div>
                                        <div class="nk-tb-col tb-col-md"><span>Tür</span></div>
                                        <div class="nk-tb-col tb-col-md"><span>Durum</span></div>
                                        <div class="nk-tb-col tb-col-md"><span>Marka</span></div>
                                        <div class="nk-tb-col tb-col-md"><span>Para Birimi</span></div>
                                        <div class="nk-tb-col tb-col-md"><span>Aktiflik</span></div>
                                        <div class="nk-tb-col tb-col-md"><span>Güncellenme</span></div>
                                        <div class="nk-tb-col nk-tb-col-tools text-end"></div>
                                    </div>

                                    @if (!Model.Products.Any())
                                    {
                                        <div class="nk-tb-item">
                                            <div class="nk-tb-col">
                                                <span class="tb-sub">Filtre kriterlerine uygun ürün bulunamadı.</span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        foreach (var product in Model.Products)
                                        {
                                            var deleteFormId = $"delete-product-{product.Id:N}";

                                            <div class="nk-tb-item">
                                                <div class="nk-tb-col tb-col-sm">
                                                    <span class="tb-product">
                                                        <span class="title">@product.Name</span>
                                                    </span>
                                                    @if (!string.IsNullOrWhiteSpace(product.ShortDescription))
                                                    {
                                                        <span class="tb-sub d-block">@product.ShortDescription</span>
                                                    }
                                                </div>
                                                <div class="nk-tb-col">
                                                    <span class="tb-lead">@product.ProductCode</span>
                                                </div>
                                                <div class="nk-tb-col tb-col-md">
                                                    <span class="tb-sub">@kindLabel(product.Kind)</span>
                                                </div>
                                                <div class="nk-tb-col tb-col-md">
                                                    <span class="tb-status @statusClass(product.Status)">@statusLabel(product.Status)</span>
                                                </div>
                                                <div class="nk-tb-col tb-col-md">
                                                    <span class="tb-sub">@(string.IsNullOrWhiteSpace(product.Brand) ? "-" : product.Brand)</span>
                                                </div>
                                                <div class="nk-tb-col tb-col-md">
                                                    <span class="tb-sub">@product.DefaultCurrencyCode</span>
                                                </div>
                                                <div class="nk-tb-col tb-col-md">
                                                    @if (product.IsActive)
                                                    {
                                                        <span class="badge badge-dim bg-success">Aktif</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-dim bg-light">Pasif</span>
                                                    }
                                                </div>
                                                <div class="nk-tb-col tb-col-md">
                                                    <span class="tb-sub">@((product.UpdatedAt ?? product.CreatedAt).ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</span>
                                                </div>
                                                <div class="nk-tb-col nk-tb-col-tools">
                                                    <ul class="nk-tb-actions gx-1 my-n1">
                                                        <li class="me-n1">
                                                            <div class="dropdown">
                                                                <a href="#" class="dropdown-toggle btn btn-icon btn-trigger" data-bs-toggle="dropdown">
                                                                    <em class="icon ni ni-more-h"></em>
                                                                </a>
                                                                <div class="dropdown-menu dropdown-menu-end">
                                                                    <ul class="link-list-opt no-bdr">
                                                                        <li>
                                                                            <a asp-action="Edit" asp-route-id="@product.Id">
                                                                                <em class="icon ni ni-edit"></em>
                                                                                <span>Düzenle</span>
                                                                            </a>
                                                                        </li>
                                                                        <li>
                                                                            <a href="#" onclick="if (confirm('Bu ürünü silmek istediğinize emin misiniz?')) { document.getElementById('@deleteFormId').submit(); } return false;">
                                                                                <em class="icon ni ni-trash"></em>
                                                                                <span>Sil</span>
                                                                            </a>
                                                                        </li>
                                                                    </ul>
                                                                </div>
                                                            </div>
                                                        </li>
                                                    </ul>

                                                    <form id="@deleteFormId" asp-action="Delete" method="post" class="d-none">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@product.Id" />
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
