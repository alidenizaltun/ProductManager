@model ProductManager.WebUI.Models.ProductOperations.ProductFormViewModel

<div class="row g-gs">
    <div class="col-12">
        <h6 class="title">Temel Bilgiler</h6>
    </div>
    <div class="col-md-4">
        <label asp-for="ProductCode" class="form-label"></label>
        <input asp-for="ProductCode" class="form-control" />
        <span asp-validation-for="ProductCode" class="text-danger"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ShortDescription" class="form-label"></label>
        <input asp-for="ShortDescription" class="form-control" />
        <span asp-validation-for="ShortDescription" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="col-12"><hr class="hr border-light"></div>
    <div class="col-12">
        <h6 class="title">Sınıflandırma ve Fiyat</h6>
    </div>
    <div class="col-md-3">
        <label asp-for="Kind" class="form-label"></label>
        <input asp-for="Kind" class="form-control" type="number" min="1" />
        <span asp-validation-for="Kind" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Status" class="form-label"></label>
        <input asp-for="Status" class="form-control" type="number" min="1" />
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="DefaultCurrencyCode" class="form-label"></label>
        <input asp-for="DefaultCurrencyCode" class="form-control" />
        <span asp-validation-for="DefaultCurrencyCode" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="TaxRate" class="form-label"></label>
        <input asp-for="TaxRate" class="form-control" type="number" step="0.01" min="0" max="100" />
        <span asp-validation-for="TaxRate" class="text-danger"></span>
    </div>

    <div class="col-12"><hr class="hr border-light"></div>
    <div class="col-12">
        <h6 class="title">Ek Bilgiler</h6>
    </div>
    <div class="col-md-3">
        <label asp-for="Brand" class="form-label"></label>
        <input asp-for="Brand" class="form-control" />
        <span asp-validation-for="Brand" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Manufacturer" class="form-label"></label>
        <input asp-for="Manufacturer" class="form-control" />
        <span asp-validation-for="Manufacturer" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Barcode" class="form-label"></label>
        <input asp-for="Barcode" class="form-control" />
        <span asp-validation-for="Barcode" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="TaxCode" class="form-label"></label>
        <input asp-for="TaxCode" class="form-control" />
        <span asp-validation-for="TaxCode" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Tags" class="form-label"></label>
        <input asp-for="Tags" class="form-control" />
        <span asp-validation-for="Tags" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <div class="alert alert-light mb-0 mt-2">
            Ek teknik metadata alanları sistem tarafından otomatik yönetilir.
        </div>
    </div>

    <div class="col-12"><hr class="hr border-light"></div>
    <div class="col-12">
        <h6 class="title">Operasyon Bayrakları</h6>
    </div>
    <div class="col-md-3">
        <div class="form-check form-switch mt-2">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-check form-switch mt-2">
            <input asp-for="IsSellable" class="form-check-input" />
            <label asp-for="IsSellable" class="form-check-label"></label>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-check form-switch mt-2">
            <input asp-for="IsPurchasable" class="form-check-input" />
            <label asp-for="IsPurchasable" class="form-check-label"></label>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-check form-switch mt-2">
            <input asp-for="TrackInventory" class="form-check-input" />
            <label asp-for="TrackInventory" class="form-check-label"></label>
        </div>
    </div>
</div>
