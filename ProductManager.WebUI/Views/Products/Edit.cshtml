@model ProductManager.WebUI.Models.Products.ProductFormViewModel

@{
    ViewData["Title"] = "Ürün Düzenle";
}

<div class="nk-content">
    <div class="container-fluid">
        <div class="nk-content-inner">
            <div class="nk-content-body">
                <div class="nk-block-head nk-block-head-sm">
                    <div class="nk-block-between">
                        <div class="nk-block-head-content">
                            <h3 class="nk-block-title page-title">Ürün Düzenle</h3>
                            <div class="nk-block-des text-soft">
                                <p>Mevcut ürün kaydını component tabanlı form yapısıyla güncelleyin.</p>
                            </div>
                        </div>
                        <div class="nk-block-head-content">
                            <a asp-action="Index" class="btn btn-outline-light">Listeye Dön</a>
                        </div>
                    </div>
                </div>

                @await Html.PartialAsync("_StatusMessage")

                <div class="nk-block">
                    <div class="card card-bordered">
                        <div class="card-inner">
                            <div class="card-head">
                                <h5 class="card-title">Ürün Bilgileri</h5>
                            </div>

                            <form asp-action="Edit" method="post" class="row g-4">
                                @Html.AntiForgeryToken()
                                <input asp-for="Id" type="hidden" />

                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                <div class="col-lg-4">
                                    <div class="form-group">
                                        <label asp-for="ProductCode" class="form-label"></label>
                                        <div class="form-control-wrap">
                                            <input asp-for="ProductCode" class="form-control" placeholder="Örn: URN-001" />
                                        </div>
                                        <span asp-validation-for="ProductCode" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-lg-8">
                                    <div class="form-group">
                                        <label asp-for="Name" class="form-label"></label>
                                        <div class="form-control-wrap">
                                            <input asp-for="Name" class="form-control" placeholder="Ürün adını girin" />
                                        </div>
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-lg-4">
                                    <div class="form-group">
                                        <label asp-for="Kind" class="form-label"></label>
                                        <div class="form-control-wrap">
                                            <select asp-for="Kind" asp-items="Model.KindOptions" class="form-select"></select>
                                        </div>
                                        <span asp-validation-for="Kind" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-lg-4">
                                    <div class="form-group">
                                        <label asp-for="Status" class="form-label"></label>
                                        <div class="form-control-wrap">
                                            <select asp-for="Status" asp-items="Model.StatusOptions" class="form-select"></select>
                                        </div>
                                        <span asp-validation-for="Status" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-lg-4">
                                    <div class="form-group">
                                        <label asp-for="DefaultCurrencyCode" class="form-label"></label>
                                        <div class="form-control-wrap">
                                            <select asp-for="DefaultCurrencyCode" asp-items="Model.CurrencyOptions" class="form-select"></select>
                                        </div>
                                        <span asp-validation-for="DefaultCurrencyCode" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-lg-4">
                                    <div class="form-group">
                                        <label asp-for="Brand" class="form-label"></label>
                                        <div class="form-control-wrap">
                                            <input asp-for="Brand" class="form-control" placeholder="Marka adı" />
                                        </div>
                                        <span asp-validation-for="Brand" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-lg-4">
                                    <div class="form-group">
                                        <label asp-for="Manufacturer" class="form-label"></label>
                                        <div class="form-control-wrap">
                                            <input asp-for="Manufacturer" class="form-control" placeholder="Üretici adı" />
                                        </div>
                                        <span asp-validation-for="Manufacturer" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-lg-4">
                                    <div class="form-group">
                                        <label asp-for="Barcode" class="form-label"></label>
                                        <div class="form-control-wrap">
                                            <input asp-for="Barcode" class="form-control" placeholder="Barkod numarası" />
                                        </div>
                                        <span asp-validation-for="Barcode" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-lg-4">
                                    <div class="form-group">
                                        <label asp-for="TaxRate" class="form-label"></label>
                                        <div class="form-control-wrap">
                                            <input asp-for="TaxRate" class="form-control" step="0.01" min="0" max="100" placeholder="0 - 100" />
                                        </div>
                                        <span asp-validation-for="TaxRate" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-lg-4">
                                    <div class="form-group">
                                        <label asp-for="TaxCode" class="form-label"></label>
                                        <div class="form-control-wrap">
                                            <input asp-for="TaxCode" class="form-control" placeholder="Örn: KDV18" />
                                        </div>
                                        <span asp-validation-for="TaxCode" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label asp-for="ShortDescription" class="form-label"></label>
                                        <div class="form-control-wrap">
                                            <input asp-for="ShortDescription" class="form-control" placeholder="Kısa açıklama girin" />
                                        </div>
                                        <span asp-validation-for="ShortDescription" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label asp-for="Description" class="form-label"></label>
                                        <div class="form-control-wrap">
                                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Ürün açıklamasını girin"></textarea>
                                        </div>
                                        <span asp-validation-for="Description" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label asp-for="Tags" class="form-label"></label>
                                        <div class="form-control-wrap">
                                            <input asp-for="Tags" class="form-control" placeholder="etiket-1, etiket-2" />
                                        </div>
                                        <span asp-validation-for="Tags" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <div class="alert alert-light mb-0">
                                            Ek teknik metadata alanları sistem tarafından otomatik yönetilir.
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="form-group">
                                        <label class="form-label">Operasyon Seçenekleri</label>
                                        <ul class="custom-control-group g-3 align-center">
                                            <li>
                                                <div class="custom-control custom-control-sm custom-checkbox">
                                                    <input asp-for="IsActive" class="custom-control-input" />
                                                    <label class="custom-control-label" for="@Html.IdFor(m => m.IsActive)">Aktif</label>
                                                </div>
                                            </li>
                                            <li>
                                                <div class="custom-control custom-control-sm custom-checkbox">
                                                    <input asp-for="IsSellable" class="custom-control-input" />
                                                    <label class="custom-control-label" for="@Html.IdFor(m => m.IsSellable)">Satılabilir</label>
                                                </div>
                                            </li>
                                            <li>
                                                <div class="custom-control custom-control-sm custom-checkbox">
                                                    <input asp-for="IsPurchasable" class="custom-control-input" />
                                                    <label class="custom-control-label" for="@Html.IdFor(m => m.IsPurchasable)">Satın Alınabilir</label>
                                                </div>
                                            </li>
                                            <li>
                                                <div class="custom-control custom-control-sm custom-checkbox">
                                                    <input asp-for="TrackInventory" class="custom-control-input" />
                                                    <label class="custom-control-label" for="@Html.IdFor(m => m.TrackInventory)">Stok Takibi</label>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="form-group">
                                        <button type="submit" class="btn btn-primary">
                                            <em class="icon ni ni-save"></em>
                                            <span>Değişiklikleri Kaydet</span>
                                        </button>
                                        <a asp-action="Index" class="btn btn-outline-light">İptal</a>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
