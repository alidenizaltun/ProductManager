@using System.Globalization
@model ProductManager.WebUI.Models.ProductOperations.PriceListDetailsPageViewModel

@{
    ViewData["Title"] = "Fiyat Listesi Detayı";
}

<div class="nk-content nk-content-fluid pm-list-page">
    <div class="container-fluid">
        <div class="nk-content-inner">
            <div class="nk-content-body">
                <partial name="_StatusMessage" />

                <div class="nk-block-head nk-block-head-sm">
                    <div class="nk-block-between g-3">
                        <div class="nk-block-head-content">
                            <h3 class="nk-block-title page-title">@Model.PriceList.Name</h3>
                            <div class="nk-block-des text-soft">
                                <p>Kod: @Model.PriceList.Code</p>
                            </div>
                        </div>
                        <div class="nk-block-head-content">
                            <div class="d-flex gap-2">
                                <a asp-action="Index" asp-route-editId="@Model.PriceList.Id" class="btn btn-primary">Düzenle</a>
                                <a asp-action="Index" class="btn btn-outline-light bg-white">Listeye Dön</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="nk-block">
                    <div class="row g-gs mb-3">
                        <div class="col-lg-12">
                            <div class="card card-bordered">
                                <div class="card-inner">
                                    <div class="row g-3">
                                        <div class="col-md-3">
                                            <div class="text-soft fs-12px">Para Birimi</div>
                                            <div class="fw-bold">@Model.PriceList.CurrencyCode</div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="text-soft fs-12px">Aktiflik</div>
                                            <div>
                                                @if (Model.PriceList.IsActive)
                                                {
                                                    <span class="badge bg-success">Aktif</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Pasif</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="text-soft fs-12px">Başlangıç</div>
                                            <div class="fw-bold">@(Model.PriceList.ValidFrom?.ToString("yyyy-MM-dd") ?? "-")</div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="text-soft fs-12px">Bitiş</div>
                                            <div class="fw-bold">@(Model.PriceList.ValidTo?.ToString("yyyy-MM-dd") ?? "-")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-gs">
                        <div class="col-lg-5">
                            <div class="card card-bordered">
                                <div class="card-inner border-bottom py-2">
                                    <h6 class="title mb-0">Yeni Kalem Ekle</h6>
                                </div>
                                <div class="card-inner">
                                    <p class="text-soft mb-3">Ürün bazlı fiyat kalemini modal form ile ekleyin.</p>
                                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addPriceListItemModal">
                                        Kalem Ekle
                                    </button>
                                </div>
                            </div>
                        </div>

                    <div class="col-lg-7">
                        <div class="card card-bordered pm-table-card">
                            <div class="card-inner border-bottom d-flex justify-content-between align-items-center">
                                <h6 class="title mb-0">Kalemler</h6>
                                <span class="text-soft small">Toplam: @Model.Items.Count</span>
                            </div>
                            <div class="card-inner p-0">
                                <div class="table-responsive">
                                    <table class="table table-tranx mb-0 pm-table">
                                        <thead>
                                            <tr class="tb-tnx-head">
                                                <th>Ürün</th>
                                                <th>Tutar</th>
                                                <th>Karşılaştırma</th>
                                                <th>Min/Max</th>
                                                <th class="text-end">İşlem</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @if (Model.Items.Count == 0)
                                        {
                                            <tr><td colspan="5" class="text-center py-4">Kalem bulunamadı.</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var row in Model.Items)
                                            {
                                                var productName = Model.Products.FirstOrDefault(x => x.Id == row.ProductId)?.Name ?? row.ProductId.ToString();
                                                <tr>
                                                    <td><span class="tb-lead">@productName</span></td>
                                                    <td><span class="tb-sub">@row.Amount.ToString("0.##", CultureInfo.InvariantCulture)</span></td>
                                                    <td>@(row.CompareAtAmount?.ToString("0.##", CultureInfo.InvariantCulture) ?? "-")</td>
                                                    <td>@(row.MinQuantity?.ToString() ?? "-") / @(row.MaxQuantity?.ToString() ?? "-")</td>
                                                    <td class="text-end">
                                                        <form method="post" asp-action="DeleteItem" asp-route-id="@Model.PriceList.Id" asp-route-itemId="@row.Id" onsubmit="return confirm('Kalem silinsin mi?');">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="addPriceListItemModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg" role="document">
                        <div class="modal-content pm-modal">
                            <form method="post" asp-action="AddItem" asp-route-id="@Model.PriceList.Id">
                                @Html.AntiForgeryToken()

                                <div class="modal-header">
                                    <h5 class="modal-title">Fiyat Listesi Kalemi Ekle</h5>
                                    <a href="#" class="close" data-bs-dismiss="modal" aria-label="Close">
                                        <em class="icon ni ni-cross"></em>
                                    </a>
                                </div>

                                <div class="modal-body">
                                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                                    <div class="mb-3">
                                        <label asp-for="NewItem.ProductId" class="form-label"></label>
                                        <select asp-for="NewItem.ProductId" class="form-select">
                                            <option value="">Ürün seçiniz</option>
                                            @foreach (var product in Model.Products)
                                            {
                                                <option value="@product.Id">@product.ProductCode - @product.Name</option>
                                            }
                                        </select>
                                        <span asp-validation-for="NewItem.ProductId" class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="NewItem.ProductVariantId" class="form-label"></label>
                                        <input asp-for="NewItem.ProductVariantId" class="form-control" />
                                    </div>
                                    <div class="row g-2 mb-3">
                                        <div class="col-md-6">
                                            <label asp-for="NewItem.Amount" class="form-label"></label>
                                            <input asp-for="NewItem.Amount" class="form-control" type="number" step="0.01" min="0.0001" />
                                            <span asp-validation-for="NewItem.Amount" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="NewItem.CompareAtAmount" class="form-label"></label>
                                            <input asp-for="NewItem.CompareAtAmount" class="form-control" type="number" step="0.01" />
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="NewItem.MinQuantity" class="form-label"></label>
                                            <input asp-for="NewItem.MinQuantity" class="form-control" type="number" min="1" />
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="NewItem.MaxQuantity" class="form-label"></label>
                                            <input asp-for="NewItem.MaxQuantity" class="form-control" type="number" min="1" />
                                        </div>
                                    </div>
                                </div>

                                <div class="modal-footer bg-light">
                                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Vazgeç</button>
                                    <button type="submit" class="btn btn-primary">Kalem Ekle</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var shouldOpenNewItemModal = @Model.OpenNewItemModal.ToString().ToLowerInvariant();
            var newItemModalElement = document.getElementById('addPriceListItemModal');

            if (newItemModalElement && shouldOpenNewItemModal && window.bootstrap) {
                window.bootstrap.Modal.getOrCreateInstance(newItemModalElement).show();
            }
        });
    </script>
}
