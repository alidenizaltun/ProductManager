@model ProductManager.WebUI.Models.ProductOperations.PriceListDetailsPageViewModel

@{
    ViewData["Title"] = "Fiyat Listesi Detayı";
    var productLookup = Model.Products.ToDictionary(x => x.Id, x => $"{x.ProductCode} - {x.Name}");
}

<div class="nk-content">
    <div class="container-fluid">
        <div class="nk-content-inner">
            <div class="nk-content-body">
                <div class="nk-block-head nk-block-head-sm">
                    <div class="nk-block-between g-3">
                        <div class="nk-block-head-content">
                            <h3 class="nk-block-title page-title">@Model.PriceList.Name</h3>
                            <div class="nk-block-des text-soft">
                                <p>Kod: @Model.PriceList.Code</p>
                            </div>
                        </div>
                        <div class="nk-block-head-content">
                            <a asp-action="Edit" asp-route-id="@Model.PriceList.Id" class="btn btn-primary">Düzenle</a>
                            <a asp-action="Index" class="btn btn-outline-light">Listeye Dön</a>
                        </div>
                    </div>
                </div>

                @await Html.PartialAsync("_StatusMessage")

                <div class="nk-block">
                    <div class="row g-gs mb-3">
                        <div class="col-lg-12">
                            <div class="card card-bordered">
                                <div class="card-inner">
                                    <div class="row g-3">
                                        <div class="col-md-3">
                                            <div class="text-soft fs-12px">Para Birimi</div>
                                            <div class="fw-bold">@Model.PriceList.CurrencyCode</div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="text-soft fs-12px">Durum</div>
                                            <div>
                                                @if (Model.PriceList.IsActive)
                                                {
                                                    <span class="badge badge-dim bg-success">Aktif</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-dim bg-light">Pasif</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="text-soft fs-12px">Başlangıç</div>
                                            <div class="fw-bold">@(Model.PriceList.ValidFrom?.ToString("dd.MM.yyyy") ?? "-")</div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="text-soft fs-12px">Bitiş</div>
                                            <div class="fw-bold">@(Model.PriceList.ValidTo?.ToString("dd.MM.yyyy") ?? "-")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-gs">
                        <div class="col-lg-4">
                            <div class="card card-bordered">
                                <div class="card-inner border-bottom py-2">
                                    <h6 class="title mb-0">Yeni Kalem Ekle</h6>
                                </div>
                                <div class="card-inner">
                                    <form method="post" asp-action="AddItem" asp-route-id="@Model.PriceList.Id" class="row g-3">
                                        @Html.AntiForgeryToken()

                                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                        <div class="col-12">
                                            <label asp-for="NewItem.ProductId" class="form-label"></label>
                                            <select asp-for="NewItem.ProductId" class="form-select">
                                                <option value="">Ürün seçiniz</option>
                                                @foreach (var product in Model.Products)
                                                {
                                                    <option value="@product.Id">@product.ProductCode - @product.Name</option>
                                                }
                                            </select>
                                            <span asp-validation-for="NewItem.ProductId" class="text-danger"></span>
                                        </div>

                                        <div class="col-12">
                                            <label asp-for="NewItem.ProductVariantId" class="form-label"></label>
                                            <input asp-for="NewItem.ProductVariantId" class="form-control" />
                                        </div>

                                        <div class="col-12">
                                            <label asp-for="NewItem.Amount" class="form-label"></label>
                                            <input asp-for="NewItem.Amount" class="form-control" type="number" step="0.01" min="0.0001" />
                                            <span asp-validation-for="NewItem.Amount" class="text-danger"></span>
                                        </div>

                                        <div class="col-12">
                                            <label asp-for="NewItem.CompareAtAmount" class="form-label"></label>
                                            <input asp-for="NewItem.CompareAtAmount" class="form-control" type="number" step="0.01" />
                                        </div>

                                        <div class="col-6">
                                            <label asp-for="NewItem.MinQuantity" class="form-label"></label>
                                            <input asp-for="NewItem.MinQuantity" class="form-control" type="number" min="1" />
                                        </div>

                                        <div class="col-6">
                                            <label asp-for="NewItem.MaxQuantity" class="form-label"></label>
                                            <input asp-for="NewItem.MaxQuantity" class="form-control" type="number" min="1" />
                                        </div>

                                        <div class="col-12">
                                            <button type="submit" class="btn btn-primary w-100">Kalem Ekle</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-8">
                            <div class="card card-bordered">
                                <div class="card-inner p-0">
                                    <div class="nk-tb-list nk-tb-ulist">
                                        <div class="nk-tb-item nk-tb-head">
                                            <div class="nk-tb-col tb-col-sm"><span>Ürün</span></div>
                                            <div class="nk-tb-col"><span>Tutar</span></div>
                                            <div class="nk-tb-col tb-col-md"><span>Karşılaştırma</span></div>
                                            <div class="nk-tb-col tb-col-md"><span>Min / Max</span></div>
                                            <div class="nk-tb-col nk-tb-col-tools text-end"></div>
                                        </div>

                                        @if (Model.Items.Count == 0)
                                        {
                                            <div class="nk-tb-item">
                                                <div class="nk-tb-col">
                                                    <span class="tb-sub">Fiyat kalemi bulunamadı.</span>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            foreach (var row in Model.Items)
                                            {
                                                var productName = productLookup.TryGetValue(row.ProductId, out var value) ? value : row.ProductId.ToString();
                                                var deleteFormId = $"delete-price-item-{row.Id:N}";

                                                <div class="nk-tb-item">
                                                    <div class="nk-tb-col tb-col-sm">
                                                        <span class="tb-lead">@productName</span>
                                                    </div>
                                                    <div class="nk-tb-col">
                                                        <span class="tb-sub">@row.Amount</span>
                                                    </div>
                                                    <div class="nk-tb-col tb-col-md">
                                                        <span class="tb-sub">@(row.CompareAtAmount?.ToString() ?? "-")</span>
                                                    </div>
                                                    <div class="nk-tb-col tb-col-md">
                                                        <span class="tb-sub">@(row.MinQuantity?.ToString() ?? "-") / @(row.MaxQuantity?.ToString() ?? "-")</span>
                                                    </div>
                                                    <div class="nk-tb-col nk-tb-col-tools">
                                                        <ul class="nk-tb-actions gx-1 my-n1">
                                                            <li class="me-n1">
                                                                <a href="#" class="btn btn-icon btn-trigger" onclick="if (confirm('Bu fiyat kalemini silmek istediğinize emin misiniz?')) { document.getElementById('@deleteFormId').submit(); } return false;">
                                                                    <em class="icon ni ni-trash"></em>
                                                                </a>
                                                            </li>
                                                        </ul>

                                                        <form id="@deleteFormId" method="post" asp-action="DeleteItem" asp-route-id="@Model.PriceList.Id" asp-route-itemId="@row.Id" class="d-none">
                                                            @Html.AntiForgeryToken()
                                                        </form>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
